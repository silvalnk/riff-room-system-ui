<%= turbo_stream_from "room-#{@room.id}" %>
<% content_for :head do %>
  <meta name="current-user-id" content="<%= Current.user&.id %>">
<% end %>
<div class="relative grid h-dvh grid-cols-1 gap-3 overflow-hidden p-3 lg:grid-cols-[minmax(0,1fr)_20rem] lg:grid-rows-[auto_minmax(12rem,34vh)_minmax(0,1fr)] lg:gap-4 lg:p-4"
     data-controller="youtube highway"
     data-youtube-interrupt-url-value="<%= room_interrupt_path(@room) %>"
     data-youtube-sync-url-value="<%= room_sync_path(@room) %>"
     data-youtube-user-id-value="<%= Current.user&.id %>"
     data-highway-press-url-value="<%= room_press_path(@room) %>"
     data-highway-user-id-value="<%= Current.user&.id %>">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_18%_-8%,rgba(124,58,237,0.34),transparent_42%),radial-gradient(ellipse_at_88%_0%,rgba(232,93,76,0.2),transparent_34%),radial-gradient(ellipse_at_50%_110%,rgba(14,165,233,0.1),transparent_42%)]"></div>
  <header class="flex flex-wrap items-center gap-3 lg:col-start-1 lg:row-start-1">
    <%= link_to "Salas", root_path, class: "rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-sm text-stone-100 no-underline hover:bg-white/10" %>
    <div class="min-w-0">
      <p class="m-0 text-[0.68rem] uppercase tracking-[0.22em] text-violet-300">Riff Room</p>
      <strong class="block truncate text-xl tracking-wide"><%= @room.name %></strong>
    </div>
    <% if @snapshot[:phase] == "playing" %>
      <span class="rounded-full bg-emerald-400/15 px-2.5 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-emerald-300">No ar</span>
    <% end %>
    <nav class="ml-auto flex flex-wrap items-center gap-2">
      <% if authenticated? %>
        <span class="text-sm text-stone-300"><%= Current.user.display_name %></span>
        <%= button_to "Sair", session_path, method: :delete, form_class: "inline-flex", class: "cursor-pointer rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-sm text-stone-100" %>
      <% else %>
        <%= link_to "Entrar", new_session_path, class: "text-sm text-stone-100 no-underline hover:text-white" %>
        <%= link_to "Criar conta", new_registration_path, class: "rounded-full bg-sky-500 px-3 py-1.5 text-sm font-semibold text-white no-underline hover:bg-sky-400" %>
      <% end %>
    </nav>
    <% if notice.present? || alert.present? %>
      <p class="m-0 w-full text-sm text-stone-400"><%= notice || alert %></p>
    <% end %>
  </header>
  <p id="room_banner" class="fixed left-1/2 top-[42%] z-50 m-0 -translate-x-1/2 -translate-y-1/2 rounded-2xl bg-rose-800/95 px-6 py-3 text-xl font-bold text-white shadow-2xl" hidden data-controller="banner"></p>
  <p class="miss-flash" hidden data-highway-target="miss">Errou</p>
  <div class="grid min-h-0 grid-cols-1 gap-3 md:grid-cols-[1.25fr_0.75fr] lg:col-start-1 lg:row-start-2">
    <div class="screen relative h-full min-h-44 overflow-hidden rounded-3xl bg-black shadow-[0_0_0_1px_rgba(255,255,255,0.08),0_20px_50px_rgba(0,0,0,0.35)]" data-youtube-target="player"></div>
    <div class="flex min-h-0 flex-col gap-2 rounded-3xl border border-white/10 bg-black/50 p-3 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)]">
      <p class="m-0 text-[0.68rem] uppercase tracking-[0.2em] text-stone-500">Notas</p>
      <canvas class="h-full min-h-36 w-full flex-1" data-highway-target="canvas" width="640" height="420"></canvas>
      <div class="highway-keys grid grid-cols-5 gap-2">
        <% %w[A S D F G].each do |key| %>
          <button type="button" data-letter="<%= key %>" data-action="click->highway#hit" class="keycap cursor-pointer text-lg"><%= key %></button>
        <% end %>
      </div>
      <p class="m-0 text-center text-[0.68rem] uppercase tracking-[0.16em] text-stone-500">Aperte a letra na linha</p>
    </div>
  </div>
  <%= render "state", snapshot: @snapshot %>
  <footer class="deck flex min-h-0 flex-col gap-3 lg:col-start-1 lg:row-start-3">
    <%= render "floor", snapshot: @snapshot %>
    <div class="flex flex-wrap items-center gap-2 rounded-2xl border border-white/10 bg-black/45 p-2">
      <div class="needs-song hidden items-center gap-2">
        <%= button_to "Dançar", room_dance_path(@room), method: :post, form_class: "inline-flex", class: "cursor-pointer rounded-full border-0 bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-500" %>
        <% if authenticated? %>
          <div class="flex items-center gap-2">
            <%= button_to room_vote_path(@room), method: :post, params: { direction: "up" }, form_class: "inline-flex", class: "inline-flex cursor-pointer items-center gap-1.5 rounded-full border-0 bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-500" do %>
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M2 21h4V9H2v12zm20-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L13.17 1 7.59 6.59C7.22 6.95 7 7.45 7 8v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-2z"/></svg>
              Gostei
            <% end %>
            <%= button_to room_vote_path(@room), method: :post, params: { direction: "down" }, form_class: "inline-flex", class: "inline-flex cursor-pointer items-center gap-1.5 rounded-full border-0 bg-rose-800 px-4 py-2 text-sm font-semibold text-white hover:bg-rose-700" do %>
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M22 3h-4v12h4V3zM2 13c0 1.1.9 2 2 2h6.31l-.95 4.57-.03.32c0 .41.17.79.44 1.06L10.83 23l5.59-5.59c.36-.36.58-.86.58-1.41V6c0-1.1-.9-2-2-2H6c-.83 0-1.54.5-1.84 1.22l-3.02 7.05c-.09.23-.14.47-.14.73v2z"/></svg>
              Não gostei
            <% end %>
          </div>
        <% end %>
      </div>
      <% if authenticated? %>
        <%= form_with url: room_enqueue_path(@room), class: "flex min-w-0 flex-1 flex-wrap items-center gap-2" do |form| %>
          <%= form.url_field :url, placeholder: "Cole a URL do YouTube", required: true, class: "min-w-48 flex-1 rounded-xl border border-white/15 bg-white/5 px-3 py-2 text-stone-100 placeholder:text-stone-500" %>
          <%= form.submit "Entrar na fila", class: "cursor-pointer rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-stone-100 hover:bg-white/10" %>
        <% end %>
      <% else %>
        <p class="m-0 text-sm text-stone-400">Você está ouvindo. Crie uma conta para votar, entrar na fila e ser DJ.</p>
      <% end %>
      <%= button_to "Estou aqui", room_enter_path(@room), method: :post, form_class: "inline-flex", class: "cursor-pointer rounded-full border-0 bg-emerald-700 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-600" %>
    </div>
  </footer>
  <%= render "chrome", snapshot: @snapshot, room: @room %>
</div>
