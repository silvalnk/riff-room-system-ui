<section class="mx-auto flex min-h-dvh w-full max-w-md flex-col justify-center px-6">
  <h1 class="mb-6 text-3xl font-semibold">Nova senha</h1>
  <% if flash[:alert] %><p class="text-rose-300"><%= flash[:alert] %></p><% end %>
  <%= form_with url: password_path(params[:token]), method: :put, class: "flex flex-col gap-3" do |form| %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Nova senha", maxlength: 72, class: "rounded-xl border border-white/15 bg-white/5 px-3 py-2 text-stone-100" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repetir senha", maxlength: 72, class: "rounded-xl border border-white/15 bg-white/5 px-3 py-2 text-stone-100" %>
    <%= form.submit "Salvar", class: "cursor-pointer rounded-full border-0 bg-sky-500 px-4 py-2 font-semibold text-white" %>
  <% end %>
</section>
